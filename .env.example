LLM_PROVIDER=vertex

# Semantic memory provider: auto, vertex, gemini, openai, or local.
# Auto uses the chat provider only when it supports native embeddings.
# Anthropic chat requires an explicit cloud provider or prepared local model.
EMBEDDINGS_PROVIDER=auto

# Voice input/output provider: auto, vertex, gemini, or openai.
# Auto reuses the chat provider and its credentials. Anthropic chat requires
# an explicit voice provider configured through the Setup Wizard.
VOICE_PROVIDER=auto

# Vertex AI
# Point this to your local Google credentials JSON file when using Vertex.
GOOGLE_APPLICATION_CREDENTIALS=credentials/credentials.json
PROJECT_ID=your-gcp-project-id
LOCATION=global
# Gemini API
GEMINI_API_KEY=

# Gemini / Vertex AI Optional Settings
# ASTAKOS_GEMINI_FAST_MODEL=gemini-3.5-flash
# ASTAKOS_GEMINI_HEAVY_MODEL=gemini-3.1-pro-preview
# Safety threshold options: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
# ASTAKOS_GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Optional local semantic memory model (requires a manual installation).
# ASTAKOS_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Google Workspace OAuth (Gmail, Drive, Calendar, Tasks, Fit, backup).
# Create token.json through the Setup Wizard's Connect / Reconnect action.
# WORKSPACE_CLIENT_SECRETS_PATH=credentials/client_secrets.json
# ASTAKOS_TOKEN_PATH=credentials/token.json

# Optional integrations
GOOGLE_PLACES_API_KEY=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
GITHUB_TOKEN=
VACUUM_IP=
VACUUM_TOKEN=
LINKEDIN_TOKEN=
