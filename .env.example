LLM_PROVIDER=vertex

# Vertex AI
# Point this to your local Google credentials JSON file when using Vertex.
GOOGLE_APPLICATION_CREDENTIALS=credentials/credentials.json
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
# Gemini API
GEMINI_API_KEY=

# Gemini / Vertex AI Optional Settings
# ASTAKOS_GEMINI_FAST_MODEL=gemini-3.5-flash
# ASTAKOS_GEMINI_HEAVY_MODEL=gemini-3.1-pro-preview
# Safety threshold options: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
# ASTAKOS_GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional integrations
GOOGLE_PLACES_API_KEY=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
GITHUB_TOKEN=
VACUUM_IP=
VACUUM_TOKEN=
LINKEDIN_TOKEN=
